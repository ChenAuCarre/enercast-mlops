# Logging
LOG_LEVEL=INFO

# Inference service
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
REFRESH_API_TOKEN=

# Monitoring / alerting (email alerts through Grafana; set SMTP_ENABLED=true to send)
SMTP_ENABLED=false
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# Grafana admin password (required: docker compose refuses to start without it)
GRAFANA_ADMIN_PASSWORD=
